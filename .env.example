# App config
APP_ENV=development
APP_PORT=8000
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./ar_copilot.db

# CORS — frontend URL
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# AI Configuration
AI_PROVIDER=mock
# GROQ_API_KEY=gsk_...
# xAI (Grok) API key — required for PAN card OCR
# Get your key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4
